        "AppImage"
      ],
      "icon": "icon.png",
      "category": "Network;Chat",
      "maintainer": "Ismail",
      "synopsis": "Fixer — задания и чат"
    }
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  }
}
