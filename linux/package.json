{
  "name": "fixer",
  "productName": "Fixer",
  "description": "Fixer — приложение для задания и чата (fixer.pythonanywhere.com)",
  "author": "Ismail",
  "version": "1.0.0",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.ismail.fixer",
    "productName": "Fixer",
    "files": [
      "main.js"
    ],
    "linux": {
