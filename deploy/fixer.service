# /etc/systemd/system/fixer.service
# Standalone systemd config (generated by setup.sh, kept as reference)

[Unit]
Description=Fixer task forum
After=network.target

[Service]
Type=exec
WorkingDirectory=/opt/fixer
ExecStart=/opt/fixer/.venv/bin/gunicorn app:app -c gunicorn.conf.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
